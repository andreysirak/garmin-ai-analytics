# Docker / Airflow runtime settings
AIRFLOW_UID=50000

# Airflow admin user (used by airflow-init)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow 3 SimpleAuth user mapping (username:ROLE)
AIRFLOW_SIMPLE_AUTH_USERS=airflow:ADMIN
# Create airflow/config/simple_auth_passwords.json from
# airflow/config/simple_auth_passwords.example.json for local credentials.

# Airflow metadata database (PostgreSQL)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
