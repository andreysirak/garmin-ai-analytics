{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "chat": {
      "type": "object",
      "properties": {
        "timezone": {"type": "string", "minLength": 1},
        "responseTokens": {"type": "integer", "minimum": 1},
        "maxQueryDays": {"type": "integer", "minimum": 1},
        "modelTimeoutSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "ollama": {
      "type": "object",
      "properties": {
        "image": {"type": "string", "pattern": "^.+:([0-9]+\\.){2}[0-9]+$"},
        "model": {"type": "string", "minLength": 1},
        "contextLength": {"type": "integer", "minimum": 512},
        "initialization": {
          "type": "object",
          "properties": {"activeDeadlineSeconds": {"type": "integer", "minimum": 1}}
        }
      }
    }
  }
}
