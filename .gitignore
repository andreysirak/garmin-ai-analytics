.DS_Store
__pycache__/
*.pyc
.idea/
*.iml
.venv/
*.log

# Local configuration and credentials
.env
*.env.local
kubeconfig*
config/credentials.local.json
config/connections.local.json
config/connections.json
airflow/config/simple_auth_passwords.json

# Build output
**/target/

# Airflow runtime artifacts
airflow/logs/*
!airflow/logs/.gitkeep

# Raw and generated data
data/*
!data/.gitkeep
